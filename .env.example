# Copy to .env.local for local development. Everything is optional locally:
# with nothing set, the app runs the rule-based demo assistant, saves to this browser, and has no accounts.

# Claude. With a key, the real design assistant answers; without one, the demo does.
ANTHROPIC_API_KEY=
# Model override (defaults to claude-opus-5-5).
OUR_BUILD_MODEL=

# Supabase: sign-in (Google and email links) and the shared household library.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: invites, pausing/archiving/deleting accounts, the sign-in gate. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, for invite and sign-in emails (an address on a domain verified in Resend).
RESEND_API_KEY=
EMAIL_FROM=Our Build <build@yourdomain.com>

# Admins who can always sign in, comma separated (your own address).
ADMIN_EMAILS=

# Optional: where links in emails point (defaults to the address the request came in on).
# SITE_URL=https://our-build.vercel.app

# Force the demo assistant even when a key is set (handy for tests).
# AI_MODE=mock
