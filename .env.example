# Copy to .env.local for local development. Everything is optional locally:
# with nothing set, the app runs the rule-based demo assistant and saves to this browser.

# Claude. With a key, the real design assistant answers; without one, the demo does.
ANTHROPIC_API_KEY=
# Model override (defaults to claude-opus-5-5).
OUR_BUILD_MODEL=

# Supabase, for sign-in and a shared household library. Leave empty to save in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Force the demo assistant even when a key is set (handy for tests).
# AI_MODE=mock
